{
  "comment": "Dashboard layout for the CYD. Optional top-level 'orientation' ('portrait' default / 'landscape') and 'theme'. Each page may have a 'name' shown in the bottom menu button; tap the centre menu to jump between pages, or use the arrows. Up to 6 pages, 6 components each. Components take row/col (omit to auto-place), rowspan and colspan (1-3). WiFi/MQTT are set on the device web page; the layout can also be loaded at runtime from a Config URL.",
  "pages": [
    {
      "name": "Climate",
      "components": [
        {
          "type": "gauge",
          "row": 0,
          "col": 0,
          "title": "Living room",
          "topic": "home/living/temp",
          "min": 0,
          "max": 40,
          "unit": "°C"
        },
        {
          "type": "gauge",
          "row": 0,
          "col": 1,
          "title": "Outside",
          "topic": "home/outside/temp",
          "min": -20,
          "max": 40,
          "unit": "°C"
        },
        {
          "type": "counter",
          "row": 1,
          "col": 0,
          "title": "Humidity",
          "topic": "home/living/hum",
          "unit": "%"
        },
        {
          "type": "counter",
          "row": 1,
          "col": 1,
          "title": "Power",
          "topic": "home/power",
          "unit": "W"
        },
        {
          "type": "text",
          "row": 2,
          "col": 0,
          "title": "Status",
          "topic": "home/status"
        },
        {
          "type": "text",
          "row": 2,
          "col": 1,
          "title": "site",
          "topic": "home/status"
        }
      ]
    },
    {
      "name": "Utilities",
      "components": [
        {
          "type": "gauge",
          "row": 0,
          "col": 0,
          "colspan": 2,
          "title": "Water tank",
          "topic": "home/water/level",
          "min": 0,
          "max": 100,
          "unit": "%"
        },
        {
          "type": "counter",
          "row": 1,
          "col": 0,
          "title": "Solar",
          "topic": "home/solar/power",
          "unit": "W"
        },
        {
          "type": "counter",
          "row": 1,
          "col": 1,
          "title": "Grid",
          "topic": "home/grid/power",
          "unit": "W"
        }
      ]
    },
    {
      "name": "Settings",
      "components": [
        {
          "type": "wifi",
          "row": 0,
          "col": 0,
          "colspan": 2,
          "title": "Wi-Fi"
        },
        {
          "type": "mqtt",
          "row": 1,
          "col": 0,
          "colspan": 2,
          "title": "MQTT"
        },
        {
          "type": "theme",
          "row": 2,
          "col": 0,
          "title": "Theme"
        },
        {
          "type": "update",
          "row": 2,
          "col": 1,
          "title": "Firmware"
        }
      ]
    },
    {
      "name": "Power",
      "components": [
        {
          "type": "graph",
          "row": 0,
          "col": 0,
          "rowspan": 3,
          "colspan": 2,
          "title": "Power today",
          "topic": "home/power",
          "entity": "sensor.power",
          "backfill": true,
          "unit": "W",
          "min": 0,
          "interval": 120,
          "agg": "avg"
        }
      ]
    },
    {
      "name": "Solar",
      "components": [
        {
          "type": "graph",
          "row": 0,
          "col": 0,
          "rowspan": 3,
          "colspan": 2,
          "title": "Solar strings",
          "unit": "W",
          "min": 0,
          "interval": 120,
          "backfill": true,
          "series": [
            {
              "topic": "home/solar/pv1",
              "entity": "sensor.pv1_power",
              "label": "PV1",
              "color": "#36d399"
            },
            {
              "topic": "home/solar/pv2",
              "entity": "sensor.pv2_power",
              "label": "PV2",
              "color": "#f5b900"
            }
          ]
        }
      ]
    }
  ]
}